@model ProductViewModel

@{
    ViewData["Title"] = "My Products";
}

<div class="dashboard-content">
    <div class="content-header">
        <h3>Products</h3>
        <button class="btn btn-primary" onclick="showAddProductModal()">
            <i class="fas fa-plus"></i> Add Product
        </button>
    </div>

    <div class="products-grid">
        @foreach (var item in Model.Products)
        {
            <div class="product-card" onclick="showProductDetail('Smartphone Pro', 'Electronics', 1234)">
                <div class="product-header">
                    <span class="product-type">@item.ProductType</span>
                    <span class="product-views"><i class="fas fa-eye"></i> 1,234</span>
                </div>
                <h4 class="product-name">@item.ProductNo</h4>
            </div>
        }
    </div>
    <div id="addProductModal" class="modal">
        <div class="modal-content">
            <div class="modal-header">
                <h3>Add New Product</h3>
                <button class="close-btn" onclick="closeAddProductModal()">
                    <i class="fas fa-times"></i>
                </button>
            </div>
            <div class="modal-body">
                <form id="addProductForm" method="post">
                    @Html.AntiForgeryToken()

                    <div class="form-group">
                        <label for="productNumber">Product Number</label>
                        <input type="text" id="productNumber" name="ProductNo" placeholder="Enter product number" required class="form-control" />
                    </div>
                    <div class="form-group">
                        <label for="productPassword">Product Password</label>
                        <input type="password" id="productPassword" name="ProductPassword" placeholder="Enter product password" required class="form-control" />
                    </div>
                    <button type="submit" class="btn btn-primary">Submit</button>
                </form>
            </div>
        </div>
    </div>
    <div id="socialMediaModal" class="modal">
        <div class="modal-content">
            <div class="modal-header">
                <h3 id="productNumberDisplay">Product: </h3>
                <button class="close-btn" onclick="closeSocialMediaModal()">
                    <i class="fas fa-times"></i>
                </button>
            </div>
            <div class="modal-body">
                <form id="submitSocialMedia" method="post">
                    @Html.AntiForgeryToken()
                    <div class="social-media-links">
                        <div class="social-item">
                            <i class="fab fa-youtube"></i>
                            <label>YouTube</label>
                            <input type="url" placeholder="Enter YouTube URL">
                        </div>
                        <div class="social-item">
                            <i class="fab fa-instagram"></i>
                            <label>Instagram</label>
                            <input type="url" placeholder="Enter Instagram URL">
                        </div>
                        <div class="social-item">
                            <i class="fab fa-twitter"></i>
                            <label>Twitter</label>
                            <input type="url" placeholder="Enter Twitter URL">
                        </div>
                        <div class="social-item">
                            <i class="fab fa-facebook"></i>
                            <label>Facebook</label>
                            <input type="url" placeholder="Enter Facebook URL">
                        </div>
                        <div class="social-item">
                            <i class="fab fa-tiktok"></i>
                            <label>TikTok</label>
                            <input type="url" placeholder="Enter TikTok URL">
                        </div>
                        <div class="social-item">
                            <i class="fab fa-linkedin"></i>
                            <label>LinkedIn</label>
                            <input type="url" placeholder="Enter LinkedIn URL">
                        </div>
                        <div class="social-item">
                            <i class="fab fa-pinterest"></i>
                            <label>Pinterest</label>
                            <input type="url" placeholder="Enter Pinterest URL">
                        </div>
                    </div>
                    <button class="btn btn-primary confirm-btn">Confirm</button>
                </form>
            </div>
        </div>
    </div>
</div>