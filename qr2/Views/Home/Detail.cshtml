@using qr2.Enum
@using qr2.ViewModel
@model ProductDetailViewModel

<!-- Product Detail Content -->
<div class="product-detail-content">
    <!-- Action Buttons -->
    <div class="detail-actions">
        <button class="btn btn-danger" onclick="deleteCurrentProduct()">
            <i class="fas fa-trash"></i> Delete
        </button>
    </div>

    <!-- QR Code and Social Media Card -->
    <div class="qr-social-card clickable-card" onclick="showEditSocialModal()">
        <div class="qr-section">
            <div class="qr-code">
                <img id="qrCodeImage" src="https://images.pexels.com/photos/8566473/pexels-photo-8566473.jpeg?auto=compress&cs=tinysrgb&w=150&h=150&dpr=1" alt="QR Code">
            </div>
        </div>
        <div class="social-section">
            <div class="social-platform">
                @{
                    string iconClass = "fab ";
                    string iconColor = "#000"; // varsayılan renk

                    switch (Model.Platform)
                    {
                        case PlatformType.instagram:
                            iconClass += "fa-instagram";
                            iconColor = "#e4405f";
                            break;
                        case PlatformType.facebook:
                            iconClass += "fa-facebook";
                            iconColor = "#3b5998";
                            break;
                        case PlatformType.youtube:
                            iconClass += "fa-youtube";
                            iconColor = "#FF0000";
                            break;
                        case PlatformType.tiktok:
                            iconClass += "fa-tiktok";
                            iconColor = "#000000";
                            break;
                        case PlatformType.twitter:
                            iconClass += "fa-twitter";
                            iconColor = "#1DA1F2";
                            break;
                        case PlatformType.linkedin:
                            iconClass += "fa-linkedin";
                            iconColor = "#0077B5";
                            break;
                        case PlatformType.pinterest:
                            iconClass += "fa-pinterest";
                            iconColor = "#BD081C";
                            break;
                        default:
                            iconClass += "fa-question";
                            iconColor = "#6c757d";
                            break;
                    }
                }
                <i id="socialPlatformIcon" class="@iconClass" style="color: @iconColor;"></i>
            </div>
            <div class="social-url">
                <a id="socialPlatformUrl" href="@Model.QrContext" target="_blank" onclick="event.stopPropagation()">@Model.QrContext</a>
            </div>
        </div>
        <div class="edit-indicator">
            <i class="fas fa-edit"></i>
            <span>Click to edit</span>
        </div>
    </div>

    <!-- Stats Cards -->
    <div class="stats-cards">
        <div class="stat-card">
            <div class="stat-header">
                <h4>Product Info</h4>
                <i class="fas fa-box"></i>
            </div>
            <div class="stat-content">
                <h3 id="productName">@Model.ProductName</h3>
                <p id="productType">Product No: @Model.ProductNo</p>
            </div>
        </div>
        <div class="stat-card">
            <div class="stat-header">
                <h4>Total Scans</h4>
                <i class="fas fa-eye"></i>
            </div>
            <div class="stat-content">
                <h3 id="totalScans">@Model.TotalScans</h3>
                <p class="stat-change positive">+12% from last month</p>
            </div>
        </div>
        <div class="stat-card">
            <div class="stat-header">
                <h4>Unique Scans</h4>
                <i class="fas fa-users"></i>
            </div>
            <div class="stat-content">
                <h3 id="uniqueScans">@Model.UniqueScans</h3>
                <p class="stat-change positive">+8% from last month</p>
            </div>
        </div>
    </div>

    <!-- Charts Section -->
    <div class="charts-section">
        <div class="chart-container">
            <div class="chart-header">
                <h4>Views Over Last 30 Days</h4>
            </div>
            <div class="chart-wrapper">
                <canvas id="viewsChart"></canvas>
            </div>
        </div>
        <div class="chart-container">
            <div class="chart-header">
                <h4>Operating System Distribution</h4>
            </div>
            <div class="chart-wrapper">
                <canvas id="osChart"></canvas>
            </div>
        </div>
    </div>
</div>

<div id="editSocialModal" class="modal">
    <div class="modal-content">
        <div class="modal-header">
            <h3>Edit Social Media Link</h3>
            <button class="close-btn" onclick="closeEditSocialModal()">
                <i class="fas fa-times"></i>
            </button>
        </div>
        <div class="modal-body">
            <form id="editSocialMediaForm" method="post">
                @Html.AntiForgeryToken()
                <div class="social-media-form">
                    <div class="form-group">
                        <label for="editSocialPlatformSelect">Select Social Media Platform</label>
                        <div class="custom-select-wrapper">
                            <select id="editSocialPlatformSelect" name="Platform" class="platform-select">
                                <option value="">Choose a platform...</option>
                                <option value="youtube" data-icon="fab fa-youtube" data-color="#ff0000">YouTube</option>
                                <option value="instagram" data-icon="fab fa-instagram" data-color="#e4405f">Instagram</option>
                                <option value="twitter" data-icon="fab fa-twitter" data-color="#1da1f2">Twitter</option>
                                <option value="facebook" data-icon="fab fa-facebook" data-color="#4267b2">Facebook</option>
                                <option value="tiktok" data-icon="fab fa-tiktok" data-color="#000000">TikTok</option>
                                <option value="linkedin" data-icon="fab fa-linkedin" data-color="#2867b2">LinkedIn</option>
                                <option value="pinterest" data-icon="fab fa-pinterest" data-color="#bd081c">Pinterest</option>
                            </select>
                            <div class="select-display">
                                <span class="select-text">Choose a platform...</span>
                                <i class="fas fa-chevron-down select-arrow"></i>
                            </div>
                            <div class="select-options">
                                <div class="select-option" data-value="">
                                    <span>Choose a platform...</span>
                                </div>
                                <div class="select-option" data-value="youtube" data-icon="fab fa-youtube" data-color="#ff0000">
                                    <i class="fab fa-youtube" style="color: #ff0000;"></i>
                                    <span>YouTube</span>
                                </div>
                                <div class="select-option" data-value="instagram" data-icon="fab fa-instagram" data-color="#e4405f">
                                    <i class="fab fa-instagram" style="color: #e4405f;"></i>
                                    <span>Instagram</span>
                                </div>
                                <div class="select-option" data-value="twitter" data-icon="fab fa-twitter" data-color="#1da1f2">
                                    <i class="fab fa-twitter" style="color: #1da1f2;"></i>
                                    <span>Twitter</span>
                                </div>
                                <div class="select-option" data-value="facebook" data-icon="fab fa-facebook" data-color="#4267b2">
                                    <i class="fab fa-facebook" style="color: #4267b2;"></i>
                                    <span>Facebook</span>
                                </div>
                                <div class="select-option" data-value="tiktok" data-icon="fab fa-tiktok" data-color="#000000">
                                    <i class="fab fa-tiktok" style="color: #000000;"></i>
                                    <span>TikTok</span>
                                </div>
                                <div class="select-option" data-value="linkedin" data-icon="fab fa-linkedin" data-color="#2867b2">
                                    <i class="fab fa-linkedin" style="color: #2867b2;"></i>
                                    <span>LinkedIn</span>
                                </div>
                                <div class="select-option" data-value="pinterest" data-icon="fab fa-pinterest" data-color="#bd081c">
                                    <i class="fab fa-pinterest" style="color: #bd081c;"></i>
                                    <span>Pinterest</span>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="form-group">
                        <label for="editSocialPlatformUrl">Platform URL</label>
                        <input type="url" id="editSocialPlatformUrl" name="QrContext" placeholder="Enter the URL for the selected platform" >
                    </div>
                </div>
                <button type="button" class="btn btn-primary confirm-btn" onclick="confirmEditSocial()">Confirm</button>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        const scanData = @Html.Raw(Json.Serialize(Model.DailyScans));
        const osData = @Html.Raw(Json.Serialize(Model.OSScans));
    </script>
    
    <script src="~/bolt/js/navigation.js"></script>
    <script src="~/bolt/js/products.js"></script>
    <script src="~/bolt/js/modals.js"></script>
    <script src="~/bolt/js/custom-select.js"></script>
    <script src="~/bolt/js/charts.js"></script>
}

<script>
    // Initialize product detail page
    document.addEventListener('DOMContentLoaded', function() {
        initializeNavigation();
        initializeProducts();
        initializeModals();

        // Load product data from sessionStorage
        const productData = JSON.parse(sessionStorage.getItem('currentProduct'));
        if (productData) {
            document.getElementById('productDetailTitle').textContent = productData.name;
            document.getElementById('productName').textContent = productData.name;
            document.getElementById('productType').textContent = productData.type;
            document.getElementById('totalScans').textContent = productData.views.toLocaleString();
            document.getElementById('uniqueScans').textContent = Math.floor(productData.views * 0.8).toLocaleString();

            // Update QR code and social media info
            updateQRSocialInfo(productData.name);

            // Store current product name for delete functionality
            currentProductName = productData.name;
        }

        // Initialize charts
        setTimeout(() => {
            initializeCharts();
        }, 100);

        // Override deleteCurrentProduct to redirect back to product list
        window.deleteCurrentProduct = function() {
            if (!currentProductName) {
                alert('No product selected for deletion.');
                return;
            }

            // Show confirmation dialog
            if (confirm(`Are you sure you want to delete "${currentProductName}"?`)) {
                // Show success message
                alert(`"${currentProductName}" has been deleted successfully.`);

                // Navigate back to product list
                window.location.href = 'product-list.html';

                // Here you would typically make an API call to delete the product
                console.log(`Product "${currentProductName}" deleted`);

                // Clear session storage
                sessionStorage.removeItem('currentProduct');
            }
        };
    });
</script>