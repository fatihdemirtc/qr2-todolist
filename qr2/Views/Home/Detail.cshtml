<div class="product-detail-content">
    <!-- Stats Cards -->
    <div class="stats-cards">
        <div class="stat-card">
            <div class="stat-header">
                <h4>Product Info</h4>
                <i class="fas fa-box"></i>
            </div>
            <div class="stat-content">
                <h3 id="productName">Smartphone Pro</h3>
                <p id="productType">Electronics</p>
            </div>
        </div>
        <div class="stat-card">
            <div class="stat-header">
                <h4>Total Scans</h4>
                <i class="fas fa-eye"></i>
            </div>
            <div class="stat-content">
                <h3 id="totalScans">1,234</h3>
                <p class="stat-change positive">+12% from last month</p>
            </div>
        </div>
        <div class="stat-card">
            <div class="stat-header">
                <h4>Unique Scans</h4>
                <i class="fas fa-users"></i>
            </div>
            <div class="stat-content">
                <h3 id="uniqueScans">987</h3>
                <p class="stat-change positive">+8% from last month</p>
            </div>
        </div>
    </div>

    <!-- Charts Section -->
    <div class="charts-section">
        <div class="chart-container">
            <div class="chart-header">
                <h4>Views Over Last 30 Days</h4>
            </div>
            <div class="chart-wrapper">
                <canvas id="viewsChart"></canvas>
            </div>
        </div>
        <div class="chart-container">
            <div class="chart-header">
                <h4>Operating System Distribution</h4>
            </div>
            <div class="chart-wrapper">
                <canvas id="osChart"></canvas>
            </div>
        </div>
    </div>
</div>