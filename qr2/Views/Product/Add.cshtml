@using qr2.ViewModel
@model AddProductViewModel

<form asp-action="Add" method="post">
    <div class="form-group">
        <label asp-for="ProductNo"></label>
        <input asp-for="ProductNo" class="form-control" />
        <span asp-validation-for="ProductNo" class="text-danger"></span>
    </div>
    <div class="form-group">
        <label asp-for="ProductPassword"></label>
        <input asp-for="ProductPassword" class="form-control" type="password" />
        <span asp-validation-for="ProductPassword" class="text-danger"></span>
    </div>
    <div class="form-group">
        <label asp-for="ProductType"></label>
        <input asp-for="ProductType" class="form-control" />
        <span asp-validation-for="ProductType" class="text-danger"></span>
    </div>
    <button type="submit" class="btn btn-primary">Ürünü Ekle</button>
</form>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
