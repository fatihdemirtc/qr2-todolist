@model qr2.Models.Product

@{
    ViewData["Title"] = "Edit Product QR Info";
}

<h2>Edit QR Info</h2>

<form asp-action="Edit" method="post">
    <input type="hidden" asp-for="RecId" />

    <div class="form-group">
        <label asp-for="QrType" class="control-label"></label>
        <input asp-for="QrType" class="form-control" />
        <span asp-validation-for="QrType" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label asp-for="QrContext" class="control-label"></label>
        <textarea asp-for="QrContext" class="form-control"></textarea>
        <span asp-validation-for="QrContext" class="text-danger"></span>
    </div>

    <button type="submit" class="btn btn-primary">Save</button>
    <a asp-action="MyProducts" class="btn btn-secondary">Cancel</a>
</form>