@using System.Globalization
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - qr2</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="/bolt/styles.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
</head>
<body>
    <div class="dashboard-container">
        <div class="sidebar">
            <div class="sidebar-header">
                <div class="logo">
                    <img src="/logo.png" alt="PlumGift Logo">
                    <span>PlumGift</span>
                </div>
            </div>
            <nav class="sidebar-nav">
                <ul>
                    <li><a href="/Home/Index" class="active"><i class="fas fa-home"></i> Products</a></li>
                    <li><a href="/Feedback/Index"><i class="fas fa-comment"></i> Feedback</a></li>
                    <li><a href="#"><i class="fas fa-cog"></i> Settings</a></li>


                    <li><a href="#"><i class="fas fa-users"></i> Admin-Users</a></li>
                    <li><a href="#"><i class="fas fa-users"></i> Admin-Products</a></li>
                    <li><a href="#"><i class="fas fa-users"></i> Admin-Feedback</a></li>
                </ul>
            </nav>
        </div>
        <div class="main-content">
            <header class="top-nav">
                <div class="nav-left">
                    <button class="menu-toggle" onclick="toggleSidebar()">
                        <i class="fas fa-bars"></i>
                    </button>
                    <h2>Dashboard</h2>
                </div>
                <div class="nav-right">
                    <form id="langForm" asp-controller="Culture" asp-action="SetLanguage" method="post">
                        @{
                            var currentCulture = CultureInfo.CurrentUICulture.Name;
                        }
                        <select class="language-select name="culture" onchange="this.form.submit();">
                            <option value="en" selected="@(currentCulture == "en")">English</option>
                            <option value="de" selected="@(currentCulture == "de")">Deutsch</option>
                            <option value="fr" selected="@(currentCulture == "fr")">Français</option>
                            <option value="es" selected="@(currentCulture == "es")">Español</option>
                            <option value="tr" selected="@(currentCulture == "tr")">Türkçe</option>
                        </select>
                        <input type="hidden" name="returnUrl" value="@Context.Request.Path" />
                    </form>
                    <div class="profile-dropdown">
                        <button class="profile-btn" onclick="toggleProfileDropdown()">
                            <img src="https://images.pexels.com/photos/1239291/pexels-photo-1239291.jpeg?auto=compress&cs=tinysrgb&w=40&h=40&dpr=1" alt="Profile">
                            <span>John Doe</span>
                            <i class="fas fa-chevron-down"></i>
                        </button>
                        <div class="profile-menu">
                            <a href="#"><i class="fas fa-user"></i> Profile</a>
                            <a href="#"><i class="fas fa-cog"></i> Settings</a>
                            <a href="#"><i class="fas fa-sign-out-alt"></i> Logout</a>
                            <form class="form-inline" asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="@Url.Page("/", new { area = "" })" method="post">
                                <button type="submit" class="nav-link btn btn-link text-dark">Click here to Logout</button>
                            </form>
                        </div>
                    </div>
                </div>
            </header>
            @RenderBody()
        </div>

    </div>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-apped-version="true"></script>
    <script src="~/bolt/script.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
