@model IEnumerable<qr2.Models.ApplicationUser>

<div class="users-content">
    <div class="users-header">
        <h3>All Users</h3>
        <p>Manage and view all registered users in the system.</p>
    </div>

    <div class="users-table-container">
        <table class="users-table">
            <thead>
                <tr>
                    <th>Email Address</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr onclick="showUserDetail('@item.Email')">
                        <td>@item.Email</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@section Scripts {
    <script src="~/bolt/js/navigation.js"></script>
    <script src="~/bolt/js/users.js"></script>
}

<script>
    // Initialize users page
    document.addEventListener('DOMContentLoaded', function() {
        initializeNavigation();
        initializeUsers();

        // Override showUserDetail to redirect to user-detail.html
        window.showUserDetail = function(email) {
            // Store user data in sessionStorage
            sessionStorage.setItem('currentUser', JSON.stringify({
                email: email
            }));
            window.location.href = 'user-detail.html';
        };
    });
</script>