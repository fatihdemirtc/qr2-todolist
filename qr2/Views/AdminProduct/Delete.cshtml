@model qr2.Models.Product

<h2>Delete Product</h2>

<div>
    <h4>Are you sure you want to delete this product?</h4>
    <div>
        <strong>Product No:</strong> @Model.ProductNo
    </div>
    <div>
        <strong>QR Type:</strong> @Model.QrType
    </div>
    <div>
        <strong>QR Context:</strong> @Model.QrContext
    </div>
</div>

<form asp-action="Delete" method="post">
    <input type="hidden" asp-for="RecId" />
    <button type="submit" class="btn btn-danger">Delete</button>
    <a asp-action="MyProducts" class="btn btn-secondary">Cancel</a>
</form>
